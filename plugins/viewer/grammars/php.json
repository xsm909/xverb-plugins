{
  "id": "php",
  "name": "PHP",
  "extensions": [
    "php",
    "phtml",
    "php3",
    "php4",
    "php5",
    "phps"
  ],
  "lineComment": [
    "//",
    "#"
  ],
  "blockComment": [
    [
      "/*",
      "*/"
    ]
  ],
  "strings": [
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    }
  ],
  "keywords": [
    "abstract",
    "and",
    "array",
    "as",
    "break",
    "callable",
    "case",
    "catch",
    "class",
    "clone",
    "const",
    "continue",
    "declare",
    "default",
    "do",
    "echo",
    "else",
    "elseif",
    "empty",
    "enddeclare",
    "endfor",
    "endforeach",
    "endif",
    "endswitch",
    "endwhile",
    "enum",
    "extends",
    "final",
    "finally",
    "fn",
    "for",
    "foreach",
    "function",
    "global",
    "goto",
    "if",
    "implements",
    "include",
    "include_once",
    "instanceof",
    "insteadof",
    "interface",
    "isset",
    "list",
    "match",
    "namespace",
    "new",
    "or",
    "print",
    "private",
    "protected",
    "public",
    "readonly",
    "require",
    "require_once",
    "return",
    "static",
    "switch",
    "throw",
    "trait",
    "try",
    "unset",
    "use",
    "var",
    "while",
    "xor",
    "yield"
  ],
  "types": [
    "bool",
    "float",
    "int",
    "iterable",
    "mixed",
    "object",
    "parent",
    "self",
    "string",
    "void"
  ],
  "constants": [
    "true",
    "false",
    "null",
    "TRUE",
    "FALSE",
    "NULL"
  ],
  "linePatterns": [
    {
      "match": "<\\?php|\\?>",
      "role": "meta"
    }
  ],
  "blocks": "braces",
  "declares": [
    "class",
    "interface",
    "trait",
    "enum",
    "function"
  ]
}
