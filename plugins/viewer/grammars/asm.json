{
  "id": "asm",
  "name": "Assembly",
  "extensions": [
    "asm",
    "s",
    "nasm"
  ],
  "caseSensitive": false,
  "lineComment": [
    ";",
    "#",
    "//"
  ],
  "strings": [
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    }
  ],
  "keywords": [
    "add",
    "align",
    "and",
    "bits",
    "call",
    "cmp",
    "db",
    "dd",
    "dec",
    "div",
    "dq",
    "dw",
    "equ",
    "extern",
    "global",
    "idiv",
    "imul",
    "inc",
    "int",
    "ja",
    "jae",
    "jb",
    "jbe",
    "je",
    "jg",
    "jge",
    "jl",
    "jle",
    "jmp",
    "jne",
    "jnz",
    "jz",
    "lea",
    "loop",
    "mov",
    "mul",
    "nop",
    "not",
    "or",
    "pop",
    "push",
    "resb",
    "resd",
    "resq",
    "resw",
    "ret",
    "sal",
    "sar",
    "section",
    "shl",
    "shr",
    "sub",
    "syscall",
    "test",
    "times",
    "xor"
  ],
  "types": [
    "ah",
    "al",
    "ax",
    "bh",
    "bl",
    "bx",
    "ch",
    "cl",
    "cx",
    "dh",
    "dl",
    "dx",
    "eax",
    "ebp",
    "ebx",
    "ecx",
    "edi",
    "edx",
    "esi",
    "esp",
    "r10",
    "r11",
    "r12",
    "r13",
    "r14",
    "r15",
    "r8",
    "r9",
    "rax",
    "rbp",
    "rbx",
    "rcx",
    "rdi",
    "rdx",
    "rsi",
    "rsp"
  ],
  "constants": [],
  "linePatterns": [
    {
      "match": "[A-Za-z_.$][\\w.$]*:",
      "role": "meta"
    },
    {
      "match": "\\.\\w+",
      "role": "keyword"
    }
  ],
  "blocks": "none"
}
