{
  "id": "groovy",
  "name": "Groovy and Gradle",
  "extensions": [
    "groovy",
    "gradle",
    "gvy"
  ],
  "names": [
    "jenkinsfile"
  ],
  "lineComment": [
    "//"
  ],
  "blockComment": [
    [
      "/*",
      "*/"
    ]
  ],
  "strings": [
    {
      "open": "'''",
      "close": "'''",
      "multiline": true
    },
    {
      "open": "\"\"\"",
      "close": "\"\"\"",
      "multiline": true
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    }
  ],
  "keywords": [
    "abstract",
    "apply",
    "as",
    "assert",
    "break",
    "case",
    "catch",
    "class",
    "def",
    "default",
    "dependencies",
    "do",
    "else",
    "enum",
    "extends",
    "final",
    "finally",
    "for",
    "if",
    "implements",
    "import",
    "in",
    "instanceof",
    "interface",
    "new",
    "package",
    "plugins",
    "private",
    "protected",
    "public",
    "repositories",
    "return",
    "static",
    "super",
    "switch",
    "task",
    "this",
    "throw",
    "throws",
    "trait",
    "try",
    "var",
    "void",
    "while"
  ],
  "types": [
    "List",
    "Map",
    "Object",
    "String",
    "boolean",
    "byte",
    "char",
    "double",
    "float",
    "int",
    "long",
    "short"
  ],
  "constants": [
    "true",
    "false",
    "null"
  ],
  "linePatterns": [
    {
      "match": "@\\w+(\\.\\w+)*",
      "role": "meta"
    }
  ],
  "blocks": "braces",
  "declares": [
    "class",
    "interface",
    "trait",
    "enum",
    "def"
  ]
}
