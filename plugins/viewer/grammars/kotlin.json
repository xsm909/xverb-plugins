{
  "id": "kotlin",
  "name": "Kotlin",
  "extensions": [
    "kt",
    "kts"
  ],
  "lineComment": [
    "//"
  ],
  "blockComment": [
    [
      "/*",
      "*/"
    ]
  ],
  "strings": [
    {
      "open": "\"\"\"",
      "close": "\"\"\"",
      "multiline": true
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    }
  ],
  "keywords": [
    "abstract",
    "actual",
    "annotation",
    "as",
    "break",
    "by",
    "catch",
    "class",
    "companion",
    "const",
    "constructor",
    "continue",
    "crossinline",
    "data",
    "do",
    "else",
    "enum",
    "expect",
    "external",
    "final",
    "finally",
    "for",
    "fun",
    "get",
    "if",
    "import",
    "in",
    "infix",
    "init",
    "inline",
    "inner",
    "interface",
    "internal",
    "is",
    "lateinit",
    "noinline",
    "object",
    "open",
    "operator",
    "out",
    "override",
    "package",
    "private",
    "protected",
    "public",
    "reified",
    "return",
    "sealed",
    "set",
    "super",
    "suspend",
    "tailrec",
    "this",
    "throw",
    "try",
    "typealias",
    "val",
    "var",
    "vararg",
    "when",
    "where",
    "while"
  ],
  "types": [
    "Any",
    "Array",
    "Boolean",
    "Byte",
    "Char",
    "Double",
    "Float",
    "Int",
    "List",
    "Long",
    "Map",
    "Nothing",
    "Set",
    "Short",
    "String",
    "Unit"
  ],
  "constants": [
    "true",
    "false",
    "null"
  ],
  "linePatterns": [
    {
      "match": "@\\w+(\\.\\w+)*",
      "role": "meta"
    }
  ],
  "blocks": "braces",
  "declares": [
    "class",
    "interface",
    "object",
    "fun"
  ]
}
