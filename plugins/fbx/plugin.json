{
  "id": "org.xverb.fbx",
  "name": "3D",
  "version": "0.17.0",
  "description": "Shows a 3D model: shaded, turnable, textured, playing its animation — or its skeleton playing it, where the file has no mesh — and what the file holds. FBX, glTF/GLB, OBJ, Maya scenes (.ma, .mb), Houdini geometry (.geo, .bgeo, .bgeo.sc), USD (.usd, .usda, .usdc, .usdz), COLLADA (.dae, .zae), 3MF, STL, PLY and OFF, one viewer for all of them.",
  "category": "Viewers",
  "author": "xverb",
  "homepage": "https://github.com/xsm909/xverb-plugins",
  "apiVersion": 3,
  "runtime": "python",
  "entry": "main.py",
  "pythonMin": "3.12",
  "icon": "view",
  "platforms": [
    "windows",
    "macos",
    "linux"
  ],
  "viewers": [
    {
      "id": "fbx.model",
      "title": "Model",
      "extensions": [
        "fbx",
        "glb",
        "gltf",
        "obj",
        "ma",
        "mb",
        "geo",
        "bgeo",
        "usd",
        "usda",
        "usdc",
        "usdz",
        "stl",
        "ply",
        "off",
        "3mf",
        "dae",
        "zae"
      ],
      "priority": 20,
      "produces": "model"
    },
    {
      "id": "fbx.contents",
      "title": "What is in the file",
      "extensions": [
        "fbx",
        "glb",
        "gltf",
        "obj",
        "ma",
        "mb",
        "geo",
        "bgeo",
        "usd",
        "usda",
        "usdc",
        "usdz",
        "stl",
        "ply",
        "off",
        "3mf",
        "dae",
        "zae"
      ],
      "priority": 10,
      "produces": ""
    },
    {
      "id": "fbx.houdini",
      "title": "Model",
      "extensions": [
        "sc"
      ],
      "priority": 20,
      "probe": true,
      "produces": "model"
    }
  ]
}
