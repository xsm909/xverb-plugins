#!/bin/sh
# Strips the Claude attribution trailers the harness asks for; this project
# carries the xsm909 signature only.
f=$1
tmp=$(mktemp)
grep -v -i -e '^Co-Authored-By: Claude' -e '^Claude-Session:' "$f" > "$tmp"
# Drop trailing blank lines the removal may leave.
awk '{ lines[NR] = $0 } END { n = NR; while (n > 0 && lines[n] ~ /^[[:space:]]*$/) n--; for (i = 1; i <= n; i++) print lines[i] }' "$tmp" > "$f"
rm -f "$tmp"
